-- The hostcall discipline, written by hand.
--
-- **You probably do not need this package.** The runtime already ships a
-- `host` library that does everything below -- `host.time()`,
-- `host.call(name, args)`, `host.try(name, args)`, `host.fs.read(path)` --
-- and it is a permanent in the core rather than a package you install. The
-- `hello` package beside this one uses it, and is what a program should
-- look like.
--
-- This exists to show the substrate. Every DRT hostcall is `{tok, call,
-- args}` out and `{tok, status, value|detail}` back. The token comes back
-- verbatim, every drained request is answered, and an unknown status means
-- error -- which is what lets the host grow new statuses without breaking
-- programs. Reading those four rules once is worth more than the fifteen
-- lines it takes to re-implement them.
--
-- The one real use for a package like this: a host that wires the pair
-- under different queue names, which `M.open{calls=..., replies=...}`
-- takes and the built-in library does not.
--
-- Nothing here is privileged. This library asks; whether an ask succeeds is
-- decided entirely by what the deployment's config granted.

local M = {}

local Client = {}
Client.__index = Client

--- Bind a client to a request/reply queue pair.
-- The names are the deployment's convention, not this library's rule: pass
-- your own when the host wired something else.
function M.open(opts)
    opts = opts or {}
    local capacity = opts.capacity or 8
    return setmetatable({
        calls = queue.declare(opts.calls or "host/calls", {
            capacity = capacity,
            exported = true,
            on_full = "reject",
        }),
        replies = queue.declare(opts.replies or "host/replies", { capacity = capacity }),
        next_tok = 0,
    }, Client)
end

--- One call. Returns the whole reply, status included — a denial is an
-- ordinary answer here, never a thrown error, because "you were not granted
-- this" is information a program is entitled to handle.
function Client:ask(call, args)
    self.next_tok = self.next_tok + 1
    local tok = self.next_tok
    queue.push(self.calls, { tok = tok, call = call, args = args })
    local _, reply = queue.wait({ self.replies })
    assert(reply.tok == tok, "the token comes back verbatim")
    return reply
end

--- The value, or nil plus the detail. For callers who want the happy path
-- to read like a normal function call.
function Client:try(call, args)
    local reply = self:ask(call, args)
    if reply.status == "ok" then
        return reply.value
    end
    return nil, reply.detail or reply.status, reply.status
end

--- The value, or raise. For setup-time calls where a denial is a bug in the
-- deployment rather than a case to handle.
function Client:must(call, args)
    local value, detail, status = self:try(call, args)
    if value == nil and detail ~= nil then
        error(string.format("%s: %s (%s)", call, tostring(detail), tostring(status)), 2)
    end
    return value
end

--- Does the host answer this call at all? Distinguishes "denied" (the host
-- knows the call; you were not granted it) from "error" (it does not).
function Client:granted(call)
    return self:ask(call, {}).status ~= "denied"
end

return M
