-- What a deployment looks like from inside a program, using the standard
-- hostcall library instead of hand-rolling the token discipline.
--
-- The program is identical whatever the host wired. What changes is what
-- the ceiling granted, and the program learns that as ordinary replies.

local hostcall = require("hostcall")
local host = hostcall.open()

-- The one nondeterminism every program eventually wants. It arrives as a
-- message, which is why a replay could replay the same moment.
local now = host:ask("time")
print("time:      " .. now.status .. " " .. tostring(now.value))

-- A file inside the directory the host granted. The config named the
-- directory; this program names the file. Neither knows the other's half.
local note, detail = host:try("fs/read", { path = "note.txt" })
print("fs/read:   " .. tostring(note or detail))

-- A family the host never wired. Answered, not dropped: every drained
-- request gets a reply, and "denied" is one.
print("sql wired: " .. tostring(host:granted("sql/query")))
