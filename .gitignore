/target

# Publishing staging tree (std-repo/publish.sh)
/.publish

# The blob projection is generated from the package tree by publish.sh; the
# tree is canonical, so committing blobs would double the repo to store a
# second copy of every byte.
/std-repo/blobs/

# Not ignored: std-repo/index.json.sig and site/std-repo.pub are COMMITTED
# once the standard repo is signed. The site build is hermetic and copies
# what is committed; the private key never comes near it.

# Site build output (site/build.sh --out)
/site/_out/

# The seeded design canvas: ~2.5MB of editor payload, regenerated by the
# seeding step from the .dc.html working files beside it.
/.design/dollup-landing-page.html

.nogit
.dump
.xtr
x.patch
x.md